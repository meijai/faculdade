@using ParceirosDaInclusao.Models

@model Campanha

<h2>Editar Campanha</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Nome da Campanha</label>
        <input asp-for="Nome" class="form-control" required />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Descrição da Meta</label>
        <textarea asp-for="Meta" class="form-control" rows="4" required></textarea>
        <span asp-validation-for="Meta" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Valor da Meta (R$)</label>
        <input asp-for="ValorMeta" class="form-control" type="number" step="0.01" required />
        <span asp-validation-for="ValorMeta" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Valor Já Arrecadado (R$)</label>
        <input asp-for="Arrecadado" class="form-control" type="number" step="0.01" />
        <small class="text-muted">Você pode alterar manualmente o valor arrecadado.</small>
    </div>

    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
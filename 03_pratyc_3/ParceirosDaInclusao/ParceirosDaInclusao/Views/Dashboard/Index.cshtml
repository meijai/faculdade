@using ParceirosDaInclusao.Models
@using System.Globalization

@model DashboardViewModel

<h2 class="mb-4">Dashboard APAE - Administrativo</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5>Total Arrecadado</h5>
                <h3>R$ @Model.TotalArrecadado.ToString("N2")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <h5>Doadores Ativos</h5>
                <h3>@Model.DoadoresAtivos</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <h5>Empresas Parceiras</h5>
                <h3>@Model.EmpresasParceiras</h3>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4 mb-3">Metas de Impacto</h4>

<div class="row">
    @foreach (var campanha in Model.Campanhas)
    {
        var percent = campanha.ValorMeta > 0
            ? Math.Round((campanha.Arrecadado / campanha.ValorMeta) * 100, 2)
            : 0;

        var percentCss = percent.ToString(System.Globalization.CultureInfo.InvariantCulture).Replace(",", ".");

        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@campanha.Nome</h5>
                    <p class="text-muted">@campanha.Meta</p>

                    <div class="progress mb-3" style="height: 30px;">
                        <div class="progress-bar bg-success fw-bold d-flex align-items-center justify-content-center"
                             style="width: @percentCss%"
                             role="progressbar"
                             aria-valuenow="@percent"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            @percent.ToString("F2")%
                        </div>
                    </div>

                    <p class="text-muted">
                        <strong>R$ @campanha.Arrecadado.ToString("N2")</strong>
                        de
                        <strong>R$ @campanha.ValorMeta.ToString("N2")</strong>
                    </p>
                </div>
            </div>
        </div>
    }
</div>
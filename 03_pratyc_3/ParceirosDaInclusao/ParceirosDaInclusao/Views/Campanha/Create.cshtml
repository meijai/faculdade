@using ParceirosDaInclusao.Models

@model Campanha

<h2>Nova Campanha</h2>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Nome da Campanha</label>
        <input asp-for="Nome" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Descrição da Meta</label>
        <textarea asp-for="Meta" class="form-control" rows="4" required></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Valor da Meta (R$)</label>
        <input asp-for="ValorMeta" class="form-control" type="number" step="0.01" min="1" required />
    </div>

    <button type="submit" class="btn btn-success">Criar Campanha</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>